# Anthropic API キー（必須）。AI社員の応答生成に使用します。
# https://console.anthropic.com/ で取得してください。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# アプリのログインパスワード（必須）。これを知っている人だけが利用できます。
# 長くランダムな文字列を推奨します。
APP_ACCESS_PASSWORD=change-me-to-a-strong-password

# セッション Cookie の署名に使う秘密鍵（任意）。
# 未設定の場合は APP_ACCESS_PASSWORD から導出されます。
# 本番では別途ランダムな値を設定することを推奨します（例: openssl rand -hex 32）。
APP_SESSION_SECRET=

# 1 分あたりの許容リクエスト数（任意、既定: 20）。
RATE_LIMIT_PER_MINUTE=20
