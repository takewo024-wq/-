# scripts/wp-publish.py が読む設定。
# コピーして .env を作り、実際の値を入れる（.env は git に含まれません）。
#
#   cp .env.example .env
#
# WP_URL          サイトのURL（末尾スラッシュなし）例: https://example.com
# WP_USER         WordPressのログインユーザー名
# WP_APP_PASSWORD アプリケーションパスワード（ログインパスワードではない）
#
# アプリケーションパスワードの作り方:
#   WordPress管理画面 → ユーザー → プロフィール → 一番下「アプリケーションパスワード」
#   名前を適当に入力（例: claude）→「新規追加」→ 表示された文字列をそのままコピー
#   （xxxx xxxx xxxx xxxx xxxx xxxx の形。スペースが入っていてもそのままでOK）

WP_URL=https://example.com
WP_USER=your-wp-username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
